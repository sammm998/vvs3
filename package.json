{
  "name": "vvs-pipe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Automatic vector-PDF pipe analysis - API, domain and UI over the Python analysis engine",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "serve": "npm run build && node dist/api/server.js"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.2"
  }
}
